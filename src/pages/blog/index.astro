  { slug: "alaska-gyms-grow-membership", title: "How Local Gyms in Alaska Can Grow Membership", excerpt: "Member engagement strategies and marketing tips for Alaska fitness centers to build a thriving community.", date: "December 25, 2025", readTime: "7 min read", category: "Fitness", image: "/images/blog/gym.jpg" },
