  { slug: "marketing-tips-juneau-small-business", title: "Top 5 Marketing Tips for Small Businesses in Juneau, Alaska", excerpt: "Low-cost, high-impact marketing strategies to attract more clients and build credibility for Juneau business owners.", date: "January 15, 2026", readTime: "6 min read", category: "Marketing", image: "/images/blog/juneau-business.jpg" },
  { slug: "alaska-retail-online-reviews", title: "How Alaska Retail Shops Can Increase Online Reviews and Boost Local Sales", excerpt: "Actionable tips for retail businesses in Anchorage, Fairbanks, and Juneau to leverage customer feedback for increased foot traffic.", date: "January 12, 2026", readTime: "7 min read", category: "Retail", image: "/images/blog/retail-alaska.jpg" },
  { slug: "seasonal-business-reviews-alaska", title: "How Seasonal Businesses in Alaska Can Stay Visible Year-Round", excerpt: "Strategies for tourism and weather-affected businesses to maintain momentum during peak and off-peak seasons.", date: "January 10, 2026", readTime: "7 min read", category: "Seasonal Business", image: "/images/blog/seasonal-alaska.jpg" },
  { slug: "respond-negative-reviews-alaska", title: "How to Respond to Negative Reviews as a Small Business Owner in Alaska", excerpt: "Turn negative feedback into opportunities with proven response strategies that protect and enhance your reputation.", date: "January 8, 2026", readTime: "6 min read", category: "Reputation", image: "/images/blog/responding-reviews.jpg" },
  { slug: "alaska-business-review-checklist", title: "The Ultimate Checklist for Alaska Business Owners to Grow Online Presence", excerpt: "A comprehensive, step-by-step checklist to systematically grow your online visibility and stand out in the Alaska market.", date: "January 5, 2026", readTime: "8 min read", category: "Guide", image: "/images/blog/business-checklist.jpg" },
  { slug: "auto-shops-alaska-customer-growth", title: "How Auto Shops in Alaska Can Get More Customers and Grow Business", excerpt: "Industry-specific strategies for Alaska auto repair shops to build trust, attract more customers, and grow sustainably.", date: "January 3, 2026", readTime: "8 min read", category: "Auto Industry", image: "/images/blog/auto-repair.jpg" },
