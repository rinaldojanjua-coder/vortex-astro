---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us | Attu Reviews"
  description="Schedule a free demo. We'll evaluate if Attu Reviews is a good fit for your business."
>
  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Get In Touch
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Have questions? We're here to help your business succeed.
      </p>
    </div>
  </section>

  <!-- Contact Info Cards -->
  <section class="py-12 bg-white">
    <div class="max-w-5xl mx-auto px-6 grid md:grid-cols-3 gap-6">
      <!-- Email -->
      <a
        href="mailto:info@attu.ai"
        class="group flex flex-col items-center text-center p-8 rounded-2xl border border-slate-200 hover:border-blue-300 hover:shadow-lg transition-all"
      >
        <div class="w-14 h-14 rounded-full bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors">
          <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-900 mb-1">Email</h3>
        <p class="text-blue-600 group-hover:text-blue-700">info@attu.ai</p>
      </a>

      <!-- Phone -->
      <a
        href="tel:+19078545033"
        class="group flex flex-col items-center text-center p-8 rounded-2xl border border-slate-200 hover:border-blue-300 hover:shadow-lg transition-all"
      >
        <div class="w-14 h-14 rounded-full bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors">
          <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-900 mb-1">Phone</h3>
        <p class="text-blue-600 group-hover:text-blue-700">(907) 854-5033</p>
      </a>

      <!-- Address -->
      <div
        class="group flex flex-col items-center text-center p-8 rounded-2xl border border-slate-200"
      >
        <div class="w-14 h-14 rounded-full bg-blue-100 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-900 mb-1">Address</h3>
        <p class="text-slate-600">1101 Gambell St, Suite 4<br />Anchorage, AK 99501</p>
      </div>
    </div>
  </section>

  <!-- Chat CTA -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-3">
          Schedule A Free Demo
        </h2>
        <p class="text-lg text-slate-600 mb-8">
          Email or call us right now — we'll evaluate if Attu Reviews is a good fit and get you set up in minutes.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="mailto:info@attu.ai"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-7 py-3.5 text-base font-semibold text-white shadow-md shadow-blue-600/20 transition hover:-translate-y-0.5 hover:bg-blue-700"
          >
            Email Us
          </a>
          <a
            href="tel:+19078545033"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 px-7 py-3.5 text-base font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50"
          >
            Call (907) 854-5033
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
