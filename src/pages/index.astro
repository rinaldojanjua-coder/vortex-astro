---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero";
import TrustedBy from "../components/TrustedBy";
import CaseStudies from "../components/CaseStudies";
import Solution from "../components/Solution";
import Comparison from "../components/Comparison";
import VideoTestimonials from "../components/VideoTestimonials";
import HowItWorks from "../components/HowItWorks";
import FAQ from "../components/FAQ";
import CTA from "../components/CTA";

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Vortex",
  "description": "Review automation built for Alaskan home service businesses.",
  "url": "https://vortex-leads.com",
  "telephone": "+19078545033",
  "email": "rinaldo@vortex-leads.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "12110 Business Blvd #6-328",
    "addressLocality": "Anchorage",
    "addressRegion": "AK",
    "postalCode": "99577",
    "addressCountry": "US",
  },
  "areaServed": "Alaska",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "100",
  },
};
---

<Layout
  title="Vortex | Review Automation for Alaskan Businesses"
  description="Get more 5-star Google reviews on autopilot. 20-minute setup, then never think about it again. Built by Alaskans, for Alaskans."
  schema={schema}
>
  <Hero client:load />
  <TrustedBy client:visible />
  <CaseStudies client:visible />
  <Solution client:visible />
  <Comparison client:visible />
  <VideoTestimonials client:visible />
  <HowItWorks client:visible />
  <FAQ client:visible />
  <CTA client:visible />
</Layout>
