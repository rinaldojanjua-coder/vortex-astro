---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Free Professional Website | Vortex"
  description="Get a free professional website for your business. No strings attached -- we're looking for testimonials to help us grow."
>
  <!-- Hero -->
  <section class="py-20 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="inline-block px-4 py-1.5 bg-blue-100 text-blue-700 text-sm font-semibold rounded-full mb-6">
        Limited Offer
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Get a Free Professional Website
      </h1>
    </div>
  </section>

  <!-- Two Column Section -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Explanation -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-6">
          Why We're Doing This
        </h2>
        <p class="text-lg text-slate-600 mb-4 leading-relaxed">
          This isn't a bait and switch. We're a growing web design and marketing agency, and we're looking for testimonials from real businesses to help us grow.
        </p>
        <p class="text-lg text-slate-600 leading-relaxed">
          By building you a free website upfront, we're investing in a long-term relationship. Over time, as our portfolio grows and more businesses see our work, we recoup the cost of your free site through new clients.
        </p>
      </div>

      <!-- Right Column: Chat CTA -->
      <div>
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-8 md:p-10 text-center">
          <div class="w-14 h-14 mx-auto rounded-full bg-blue-100 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-4 4v-4z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Claim Your Free Website
          </h3>
          <p class="text-slate-600 mb-8">
            Message us using the chat in the bottom-right corner, or reach out directly — we'll be in touch within 24 hours.
          </p>
          <div class="flex flex-col gap-3">
            <a
              href="mailto:rinaldo@vortex-leads.com"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-7 py-3.5 text-base font-semibold text-white shadow-md shadow-blue-600/20 transition hover:-translate-y-0.5 hover:bg-blue-700"
            >
              Email Us to Get Started
            </a>
            <a
              href="tel:+19078545033"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-7 py-3.5 text-base font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300"
            >
              Call (907) 854-5033
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
