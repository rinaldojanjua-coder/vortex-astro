---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Free Professional Website | Vortex"
  description="Get a free professional website for your business. No strings attached -- we're looking for testimonials to help us grow."
>
  <!-- Hero -->
  <section class="py-20 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="inline-block px-4 py-1.5 bg-blue-100 text-blue-700 text-sm font-semibold rounded-full mb-6">
        Limited Offer
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Get a Free Professional Website
      </h1>
    </div>
  </section>

  <!-- Two Column Section -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Explanation -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-6">
          Why We're Doing This
        </h2>
        <p class="text-lg text-slate-600 mb-4 leading-relaxed">
          This isn't a bait and switch. We're a growing web design and marketing agency, and we're looking for testimonials from real businesses to help us grow.
        </p>
        <p class="text-lg text-slate-600 leading-relaxed">
          By building you a free website upfront, we're investing in a long-term relationship. Over time, as our portfolio grows and more businesses see our work, we recoup the cost of your free site through new clients.
        </p>
      </div>

      <!-- Right Column: Form -->
      <div>
        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-6 md:p-8">
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Get Your Free Website
          </h3>
          <p class="text-slate-600 mb-6">
            Fill out the form below and we'll be in touch within 24 hours.
          </p>
          <iframe
            src="https://link.vortex-leads.com/widget/survey/HqWaxi3xIbjqSsL2O8mf"
            style="width:100%; height:600px; border:none;"
            title="Free Website Form"
            loading="lazy"
          ></iframe>
          <script src="https://link.vortex-leads.com/js/form_embed.js"></script>
        </div>
      </div>
    </div>
  </section>
</Layout>
